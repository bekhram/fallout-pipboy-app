+                      className="pip-input pip-armor-mini-input"
+                      type="number"
+                      min="0"
+                      value={value}
+                      readOnly={!canAdjust}
+                      onChange={canAdjust ? (event) => setResistance(part, field.key, event.target.value) : undefined}
+                      title={t(field.labelKey)}
+                    />
+                    {canAdjust && (
