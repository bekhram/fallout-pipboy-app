# Pip-2D20 cloud migration
# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=

# Firebase Web API key and project id
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Telegram event bridge (server-side Vercel env vars; never prefix with VITE_)
TELEGRAM_BOT_TOKEN=
# Optional custom webhook URL. Default: https://www.pip-2d20.fun/api/telegram-webhook
TELEGRAM_WEBHOOK_URL=
# Optional comma-separated extra allowed browser origins
TELEGRAM_ALLOWED_ORIGINS=
